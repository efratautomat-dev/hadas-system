# hadas-v2 — environment variable NAMES only. Fill in values in a local .env (never commit .env).
# Copy this file to .env and populate. Values here are intentionally blank.

# ── Frontend (Vite — shipped to the browser; anon key is public BY DESIGN) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: set to enable demo mode (synthetic data, no backend)
VITE_DEMO_MODE=

# ── Supabase (server-side / Edge Functions — NEVER expose to the client) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── App auth (machine-to-machine key for cron / automations) ──
HADAS_API_KEY=
# Legacy fallback used by some functions if SUPABASE_SERVICE_ROLE_KEY is absent.
# Deprecated — slated for removal in the rebuild (see spec/10-SECURITY.md). Leave blank.
# HADAS_SERVICE_KEY=

# ── Gmail ingest (OAuth) ──
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# ── AI extraction ──
ANTHROPIC_API_KEY=

# ── Google Drive filing (folder IDs — env only, never in code or spec) ──
DRIVE_FOLDER_INVOICES=
DRIVE_FOLDER_DELIVERY=
DRIVE_FOLDER_RETURNS=
DRIVE_FOLDER_STATEMENTS=
