{
  "name": "hadas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-twins.mjs && tsc -b && vite build",
    "build:demo": "node scripts/check-twins.mjs && tsc -b && vite build --mode demo --outDir dist-demo",
    "build:shell": "node scripts/build-shell.mjs",
    "sync:android": "npm run build:shell && npx cap sync android",
    "build:apk": "node scripts/release-apk.mjs",
    "build:aab": "node scripts/release-apk.mjs --aab",
    "deploy": "node scripts/deploy.mjs",
    "deploy:demo": "node scripts/deploy.mjs --only=demo",
    "deploy:vercel": "node scripts/deploy.mjs --only=vercel",
    "lint": "node scripts/check-twins.mjs && eslint .",
    "check:twins": "node scripts/check-twins.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@supabase/supabase-js": "^2.105.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.14.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.13",
    "supabase": "^2.109.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
